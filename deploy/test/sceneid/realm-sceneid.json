{
  "realm": "sceneid",
  "displayName": "SceneID (test stand-in)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "forgejo",
      "name": "Forgejo nodes",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "forgejo-test-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://forgejo-se.test:3001/*",
        "http://forgejo-dk.test:3002/*",
        "http://forgejo-de.test:3003/*",
        "http://forgejo-uk.test:3004/*",
        "http://forgejo-us.test:3005/*"
      ],
      "webOrigins": [
        "+"
      ],
      "protocolMappers": [
        {
          "name": "nickname",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "nickname",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "forgesync",
      "name": "ForgeSync controller (reads and disables SceneID users)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "forgesync-test-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true
    },
    {
      "clientId": "forgesync-admin",
      "name": "ForgeSync admin UI",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "forgesync-admin-test-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://forgesync.test:8090/api/v1/auth/callback",
        "http://forgesync-b.test:8091/api/v1/auth/callback",
        "http://127.0.0.1:8090/api/v1/auth/callback",
        "http://127.0.0.1:8091/api/v1/auth/callback",
        "http://127.0.0.1:5173/api/v1/auth/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://forgesync.test:8090/##http://127.0.0.1:8090/##http://127.0.0.1:5173/",
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-forgesync",
      "enabled": true,
      "serviceAccountClientId": "forgesync",
      "clientRoles": {
        "realm-management": [
          "view-users",
          "manage-users"
        ]
      }
    },
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@sceneid.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Andersson",
      "credentials": [
        {
          "type": "password",
          "value": "alice-pw",
          "temporary": false
        }
      ],
      "realmRoles": [
        "forgesync-admin"
      ]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@sceneid.test",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Berg",
      "credentials": [
        {
          "type": "password",
          "value": "bob-pw",
          "temporary": false
        }
      ],
      "realmRoles": [
        "forgesync-operator"
      ]
    },
    {
      "username": "carol",
      "enabled": true,
      "email": "carol@sceneid.test",
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "Christensen",
      "credentials": [
        {
          "type": "password",
          "value": "carol-pw",
          "temporary": false
        }
      ],
      "realmRoles": [
        "forgesync-viewer"
      ]
    },
    {
      "username": "erin",
      "enabled": true,
      "email": "erin@sceneid.test",
      "emailVerified": true,
      "firstName": "Erin",
      "lastName": "Eriksson",
      "credentials": [
        {
          "type": "password",
          "value": "erin-pw",
          "temporary": false
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "forgesync-admin",
        "description": "ForgeSync administrator"
      },
      {
        "name": "forgesync-operator",
        "description": "ForgeSync operator"
      },
      {
        "name": "forgesync-viewer",
        "description": "ForgeSync viewer"
      }
    ]
  },
  "loginTheme": "sceneid"
}
