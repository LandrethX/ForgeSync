# Test-only values. Never reuse these outside the local test environment.
FORGEJO_VERSION=16
KEYCLOAK_VERSION=26.7.4

SCENEID_ADMIN_USER=admin
SCENEID_ADMIN_PASSWORD=admin

# Must match the "forgejo" client secret in sceneid/realm-sceneid.json.
SCENEID_FORGEJO_CLIENT_SECRET=forgejo-test-secret

# Local Forgejo admin accounts created on every node by setup.sh.
FORGEJO_SITEADMIN_PASSWORD=siteadmin-test-pw
FORGEJO_FORGESYNC_PASSWORD=forgesync-test-pw

# Shared secret for webhooks sent to the hooksink service (Phase 0 probes).
HOOK_SECRET=hook-test-secret

# Must match the "forgesync" client secret in sceneid/realm-sceneid.json.
SCENEID_FORGESYNC_CLIENT_SECRET=forgesync-test-secret
